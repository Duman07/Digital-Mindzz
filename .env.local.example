# ============================================================
# DIGITAL MINDZ — Variables de Entorno
# Copia este archivo como .env.local y completa los valores
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Stripe ---
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # Desde: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# --- Wompi ---
# Obtén tus keys en: https://comercios.wompi.co
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...   # Secreto de integridad
WOMPI_EVENTS_SECRET=test_events_...         # Secreto de eventos (webhooks)

# --- Anthropic (Claude Agents) ---
# NUNCA exponer al cliente. Solo en API routes del servidor.
ANTHROPIC_API_KEY=sk-ant-...

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Digital Mindz

# ============================================================
# GUÍA RÁPIDA DE CONFIGURACIÓN
# ============================================================
# 1. Supabase:
#    - Crea proyecto en https://supabase.com
#    - Ejecuta supabase/migrations/001_schema.sql en SQL Editor
#    - Ejecuta supabase/migrations/002_seed.sql en SQL Editor
#    - Copia URL y anon key desde Project Settings > API
#
# 2. Stripe (pagos internacionales):
#    - Registrate en https://stripe.com
#    - Modo test activo por defecto
#    - Para webhooks locales: npx stripe listen --forward-to localhost:3000/api/webhooks/stripe
#
# 3. Wompi (pagos Colombia):
#    - Registrate en https://comercios.wompi.co
#    - Modo sandbox disponible para pruebas
#    - Configura webhook URL: https://tu-dominio.com/api/webhooks/wompi
#
# 4. Anthropic:
#    - Obtén API key en https://console.anthropic.com
#    - Solo necesaria cuando actives los agentes Claude
