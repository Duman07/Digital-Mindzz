# ============================================================
# DIGITAL MINDZ — .env.local (DESARROLLO LOCAL)
# Reemplaza los valores con tus credenciales reales cuando
# vayas a conectar Supabase, Stripe y Wompi.
# ============================================================

# --- Supabase (reemplazar con tus keys reales) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Wompi ---
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_placeholder
WOMPI_PRIVATE_KEY=prv_test_placeholder
WOMPI_INTEGRITY_SECRET=test_integrity_placeholder
WOMPI_EVENTS_SECRET=test_events_placeholder

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-placeholder

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Digital Mindz
